# Placeholder example only. Real values live in Vercel project settings, never in Git.
# See docs/cloud-foundation.md for where each variable is configured.

# Deployment environment bound in src/server/config/environments.ts: development | production
TUTOR_MBOS_ENV=development

# Supabase project URL for that environment (public value, must match the reviewed binding)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key only; never a secret or service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<placeholder>

# Server-only. Username must be app_runtime for the environment above. Never a migration or service-role URL.
# TUTOR_MBOS_APP_DATABASE_URL=postgresql://app_runtime.<project-ref>:<password>@<host>:6543/postgres
